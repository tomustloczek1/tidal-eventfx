---- toolz.tidal
-- needs `:set -package containers` and `:set -package hosc` as the FIRST lines of BootTidal.hs
-- load order (BootTidal): toolz.tidal, toolz-fx.tidal (generated by EventFX), then f/* (load-functions.tidal)

import qualified Data.Map.Strict as Map
import Data.IORef
import Data.List (nubBy)
import Data.Function (on)
import Control.Exception (try, evaluate, IOException)
import System.Environment (getEnv)
import Text.Read (readMaybe)

---- timing

-- measured MIDI vs audio latency through BlackHole, in seconds
midiLatency = 0.038

-- recording offset in seconds: the whole toMidi output is sent this much earlier, so notes
-- recorded into Live land on the grid. Depends on Live's audio output (Live adds its output
-- latency to recordings; Bluetooth changes from one connection to the next).
-- `reccal` (Link on!) measures it, uses the new value at once and saves it in
-- ~/.config/tidal/midishift.txt (not in the repo) - the values below are only the fallback.
shiftDefaults = [("wire", -0.0111), ("bt", 0.3955)] :: [(String, Double)]

-- which output `bpm` assumes: True = Bluetooth headphones, False = cable / speakers
-- (bpmBT / bpmWire choose it directly)
useBT = True

-- lead of the FX CCs (and their value marker, CC 119) before the note, in seconds;
-- the values go straight into the note's own rack chain, so a bigger lead is safe
ccLead = 0.15

-- lead of the selector marker (CC 118) before the note, in seconds: the Chain Selector
-- switches about (selLead - LOM delay) before the note; that gap must be shorter than
-- the distance to the previous note, or the previous note lands in the new chain.
-- tune with EventFX's "routing" log: missed + "expected N, started N-1" = too small,
-- "expected N, started N+1" = too big; tuned at 140 BPM on notes ~53 ms apart: best 0.02-0.03
selLead = 0.026

-- after changing any of these: reload this file - the end of this section applies them at
-- the current tempo

shiftFile <- fmap (++ "/.config/tidal/midishift.txt") (getEnv "HOME")

:{
-- saved recording offsets: lines "bt 0.3955" / "wire -0.0111"
loadShifts :: IO [(String, Double)]
loadShifts = do
  r <- try (readFile shiftFile >>= \c -> evaluate (length c) >> return c) :: IO (Either IOException String)
  return [ (k, v) | Right c <- [r], [k, x] <- map words (lines c), Just v <- [readMaybe x] ]
:}

shiftsRef <- loadShifts >>= \saved -> newIORef (saved ++ shiftDefaults)   -- saved values win
recRef <- newIORef (140 :: Double, if useBT then "bt" else "wire" :: String)  -- tempo, output in use

:{
shiftOf :: String -> IO Double
shiftOf k = fmap (maybe 0 id . lookup k) (readIORef shiftsRef)

-- new offset for output k: used from now on and saved for the next sessions
setShift :: String -> Double -> IO ()
setShift k v = do
  modifyIORef shiftsRef ((k, v) :)
  cur <- fmap (nubBy ((==) `on` fst)) (readIORef shiftsRef)
  writeFile shiftFile (unlines [ name ++ " " ++ show x | (name, x) <- cur ])

-- shifts for tempo b (BPM) with the offset of output k, without touching the tempo
bpmState :: String -> Double -> IO ()
bpmState k b = do
  writeIORef recRef (b, k)
  shift <- shiftOf k
  setF "nud" (pure (midiLatency * b / 240))
  setF "ccShift" (pure (ccLead * b / 240))        -- CC lead converted to cycles
  setF "selShift" (pure (selLead * b / 240))      -- selector marker lead converted to cycles
  setF "midiShift" (pure (shift * b / 240))       -- recording offset converted to cycles

-- the same + set the tempo (with Link on, Live follows)
bpmWith :: String -> Double -> IO ()
bpmWith k b = do
  setcps (pure (b / 240))
  bpmState k b

bpm, bpmBT, bpmWire :: Double -> IO ()
bpm b     = bpmWith (if useBT then "bt" else "wire") b
bpmBT b   = bpmWith "bt" b
bpmWire b = bpmWith "wire" b
:}

-- apply the values above now, at the tempo Tidal runs at (no tempo change)
streamGetcps tidal >>= \c -> bpmState (if useBT then "bt" else "wire") (realToFrac c * 240)

---- MIDI basics

m c = s "m" # midichan (c - 1) # nudge (cF 999 "nud")

-- raw CC on the note port (Bus 1), same channel as the track (debug / manual use)
ccT c n v = ccv (v * 127) # s "m" # midichan (c - 1) # ccn n # nudge (cF 0.0222 "nud")

---- per-event FX -> CC on the note port (EventFX)

:{
-- one CC event carrying an FX value of event ev (same channel and nudge as the note)
ccEvent :: ValueMap -> Double -> Double -> ValueMap
ccEvent ev num v = Map.fromList
  [ ("s",        VS "m")
  , ("midichan", Map.findWithDefault (VF 0) "midichan" ev)
  , ("ccn",      VF num)
  , ("ccv",      VF v)
  , ("nudge",    VF (maybe 0 id (Map.lookup "nudge" ev >>= getF)))
  ]
:}

:{
-- one marker CC per note, sent just before that note's parameter CCs;
-- EventFX uses it to pick a rack chain. Its value keeps changing because
-- Live drops repeated CC values while recording and when playing clips.
ccMark :: Double -> ControlPattern -> ControlPattern
ccMark num p = fmap toCC p # ccv (range 1 126 $ fast 17.3 saw)
  where
    toCC m = Map.fromList
      [ ("s",        VS "m")
      , ("midichan", Map.findWithDefault (VF 0) "midichan" m)
      , ("ccn",      VF num)
      , ("ccv",      VF 0)
      , ("nudge",    VF (maybe 0 id (Map.lookup "nudge" m >>= getF)))
      ]
:}

:{
-- same CC events with value 127: sent just before the real values so consecutive
-- values always differ (Live drops repeated CC values when recording and playing clips)
ccSentinel :: ControlPattern -> ControlPattern
ccSentinel = fmap (Map.insert "ccv" (VF 127))
:}

:{
-- notes + markers + one CC per FX param the event has, looked up in the map of the
-- event's track (MIDI channel). Params missing from that map are ignored (not in that
-- track's palette). Real values are 0..126 (127 = sentinel).
-- toolz-fx.tidal (generated) defines the maps and: toMidi = toMidiWith fxCC fxOn
toMidiWith :: Map.Map Int (Map.Map String Double)
           -> Map.Map Int (Map.Map String [(Double, Double)])
           -> Pattern Double -> ControlPattern -> ControlPattern
toMidiWith ccMap onMap ch p0 = (toRational <$> segment 1 (cF 0 "midiShift")) <~ stack
  [ p
  , (toRational <$> segment 1 (cF 0 "selShift")) <~ ccMark 118 p
  , (toRational <$> segment 1 (cF 0 "ccShift" + 0.003)) <~ ccMark 119 p
  , (toRational <$> segment 1 (cF 0 "ccShift" + 0.0015)) <~ ccSentinel ccs
  , (toRational <$> segment 1 (cF 0 "ccShift")) <~ ccs
  ]
  where
    p = p0 # m ch
    ccs = flatpat $ fmap toCCs p          -- list per event -> simultaneous CC events
    toCCs ev =
      [ ccEvent ev num (min 1 (max 0 v) * 126)
      | (name, val) <- Map.toList ev
      , Just num <- [Map.lookup name ccTrack]
      , Just v <- [getF val] ]
      ++
      [ ccEvent ev num (x * 126)          -- e.g. BPF Dry/Wet on together with bpfA
      | name <- Map.keys ev
      , Just ons <- [Map.lookup name onTrack]
      , (num, x) <- ons ]
      where
        chan    = maybe 1 (\c -> floor c + 1) (Map.lookup "midichan" ev >>= getF) :: Int
        ccTrack = Map.findWithDefault Map.empty chan ccMap
        onTrack = Map.findWithDefault Map.empty chan onMap
:}

