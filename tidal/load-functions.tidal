-- load-functions.tidal : loads toolz-fx-names.tidal and toolz-fx-catalog.tidal, then every *.tidal
-- file from ~/.config/tidal/f/
--
-- files are loaded in alphabetical order, so prefix them with numbers when one
-- depends on another (05-helper.tidal, 06-inst.tidal, 30-rec.tidal, ...)
--
-- how it works: the shell lists the files (sorted) and writes one ":script <file>" line per
-- file into a temporary file, then ":script" runs that file line by line - each file is
-- finished before the next one starts (":cmd" would queue all lines at once, and every
-- nested :script would take the next queued line first: the files ran in reverse order)
--
-- toolz-fx-names.tidal (EventFX: the names of the effects on your tracks) and toolz-fx-catalog.tidal
-- (EventFX after fxscan: names of every audio effect in Live's browser) come first, when they exist
--
-- load order in a session:
--   :script ~/.config/tidal/toolz.tidal
--   :script ~/.config/tidal/toolz-fx.tidal
--   :script ~/.config/tidal/load-functions.tidal
--
-- after editing a file in f/ run this script again and re-evaluate your d1..d16

:! { for c in ~/.config/tidal/toolz-fx-names.tidal ~/.config/tidal/toolz-fx-catalog.tidal; do [ -f "$c" ] && echo ":script $c"; done; for f in ~/.config/tidal/f/*.tidal; do [ -e "$f" ] && echo ":script $f"; done; } > /tmp/tidal-functions.ghci

:script /tmp/tidal-functions.ghci
